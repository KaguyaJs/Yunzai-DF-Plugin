{
  "name": "yunzai-df-plugin",
  "version": "2.13.0",
  "description": "Yunzai拓展插件",
  "keywords": [
    "Yunzai"
  ],
  "license": "GPL-3.0-only",
  "author": "DengFengLai",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "rimraf lib && tsc && tsc-alias && minify lib",
    "build:noMinify": "rimraf lib && tsc && tsc-alias",
    "build:watch": "rimraf lib && tsc && (concurrently \"tsc -w\" \"tsc-alias -w\")",
    "update:emoji": "up-emoji resources/json/Emoji.json",
    "test:code-update": "node --test tests/code-update.test.cjs tests/commits-update.test.cjs tests/git-themes.test.cjs",
    "preview:git-themes": "node tests/preview-git-themes.cjs",
    "test:maintenance": "node --test tests/maintenance.test.cjs",
    "lint": "eslint ./src --fix"
  },
  "dependencies": {
    "https-proxy-agent": "^7.0.6",
    "lodash": "^4.18.1",
    "marked": "^18.0.14",
    "node-fetch": "^3.3.2",
    "ulid": "^3.0.2"
  },
  "files": [
    "./index.js",
    "./package.json",
    "./README.md",
    "./CHANGELOG.md",
    "./LICENSE",
    "./lib",
    "./resources/",
    "./guoba.support.js"
  ]
}
